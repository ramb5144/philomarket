rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all client access. Every read and write goes through the server
    // API using the Admin SDK, which bypasses these rules. This includes the
    // server-only auditLog, idempotencyKeys, and accountEmails collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
